# Base de datos (SQLite por defecto en local; PostgreSQL Neon/Supabase en produccion)
DATABASE_URL=sqlite:///./asesor_pedagogico.db

# Seguridad JWT (cambiar obligatoriamente en produccion)
JWT_SECRET_KEY=dev-secret-key-change-before-production
JWT_EXPIRE_MINUTES=480

# Proveedor IA principal: gemini | groq | ollama | lmstudio | deterministic
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=qwen2.5-coder-1.5b

# Sandbox de verificacion de codigo: static_only | isolated_subprocess
SANDBOX_MODE=static_only
SANDBOX_TIMEOUT_SECONDS=5

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Acceso abierto para revision/sustentacion (cambiar a false para exigir login JWT obligatorio)
PUBLIC_DEMO_MODE=true

# Usuarios iniciales de demostracion (cambiar en produccion)
DEMO_STUDENT_PASSWORD=Estudiante2026!
DEMO_TEACHER_PASSWORD=Docente2026!
DEMO_ADMIN_PASSWORD=Admin2026!
